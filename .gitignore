# Python
__pycache__/
*.py[cod]
*.pyo
.venv/
venv/
.pytest_cache/
.coverage
htmlcov/
.mypy_cache/
.ruff_cache/
*.egg-info/

# Local config (copy config.example.json → config.json)
config.json
config.json.lock

# Per-install user data (notes, shared UI state such as pins)
model-notes.json
ui-state.json

# Local model weights (developer checkout keeps them under ./models)
models/*
!models/.gitkeep

# Native llama.cpp build outputs stay outside source control.
llama.cpp/build/

# Runtime logs
logs/
*.log

# Secrets
.env
.env.*
!.env.admin.example
*.pem
*.key
*.p12
*.pfx
!electron/resources/update-manifest-public.pem
# Generated at build time from the DFLASH_UPDATE_TOKEN secret (CI) or the local
# .env.admin — holds the update-feed token, so it must never be committed.
electron/resources/update-endpoint.json

# Runtime bundles (installed outside the installer)
runtimes/*
!runtimes/.gitkeep

# Generated by tools/dflash-setup-ui/build.ps1 from package.json
tools/dflash-setup-ui/SetupVersion.cs
tools/dflash-setup-ui/bin/
tools/dflash-setup-ui/bin_payload/

# Python package build
dist-pypi/
*.egg-info/

# Node / Electron
node_modules/
dist-electron/
electron/runtime-staging/
build/
dist/
npm-debug.log*
yarn-error.log*

# OS / editor
.DS_Store
Thumbs.db
*.swp
.idea/
.vscode/

# Local debug / scratch (may contain machine paths or API dumps)
tmp-*
tmp_*

# Local UI screenshots and Playwright test artifacts
shots/
test-results/
playwright-report/

# LAN deployment config (copy example → config.production-deploy.json)
scripts/deployment/config.production-deploy.json
/_verify-0.3.232/DFlash-Console-Portable-0.3.232-x64.exe
/_verify-0.3.232/DFlash-Console-Setup-0.3.232-x64.exe
/_verify-*/
*.bak*
/.current-dflash-diff.txt
*.exe
# Standalone 7-Zip extractor embedded in the Windows setup UI (setup must
# unpack its own package on machines without 7-Zip installed).
!tools/7za-x64.exe
!tools/7za-x86.exe
/.tmp-*
*-bak
/scripts/test-report-upload.sh
/scripts/check-wp-mail.php
/scripts/test-wp-mail-send.php
/scripts/resend-latest-dflash-report-mail.php

# Local runtime backup snapshots (config copies, undo scripts, logs)
/backups/
